{
  "name": "Gas Town (full stack)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "init": true,
  "mounts": [
    "source=${devcontainerId}-gastown-home,target=/home/vscode,type=volume"
  ],
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Gas Town dashboard",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
